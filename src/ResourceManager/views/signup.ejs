<%- include('header', {title: pagetitle}) -%>
<div class="container-fluid">
    <h1>Regisztráció</h1>
    <form method="post">
        <div class="form-outline mb-4">
            <input type="email" id="email" class="form-control" name="email"/>
            <label class="form-label" for="email">Email cím</label>
        </div>

        <div class="form-outline mb-4">
            <input type="text" id="username" class="form-control" name="username"/>
            <label class="form-label" for="username">Felhasználónév</label>
        </div>

        <div class="form-outline mb-4">
            <input type="password" id="password" class="form-control" name="password"/>
            <label class="form-label" for="password">Jelszó</label>
        </div>
        <%if(passworderror){%>
            <p class="text-danger">Hibas jelszo formatum!</p>
        <%}%>

        <input type="submit" class="btn btn-primary" value="Regisztráció"/>

    </form>
</div>
<%- include('footer') -%>